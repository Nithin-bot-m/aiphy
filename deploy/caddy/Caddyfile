# Caddy reverse proxy — automatic HTTPS for the public entrypoint.
# Replace {PUBLIC_DOMAIN} with your domain (envsubst via deploy script or edit inline).

{$PUBLIC_DOMAIN:localhost} {
	encode zstd gzip

	# API — proxied directly (web's Next.js proxy path is kept for dev parity,
	# but production routes /api straight to the deterministic service).
	handle /api/* {
		reverse_proxy api:4000
	}

	# Next.js product frontend
	handle {
		reverse_proxy web:3000
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}
