{"_meta": {"module": 6, "name": "EQ and Soft Skills", "batch": 1, "subs": ["TEAM", "STRESS", "LEAD", "COMM", "EMPATHY", "SELFCONTROL"], "scales": {"AGREE5": {"1": "Strongly disagree", "2": "Disagree", "3": "Neutral", "4": "Agree", "5": "Strongly agree"}}, "scoring": "EQ = 0.7 * SJT percent of max + 0.3 * self-report percent. If SJT and self-report differ by more than 30 points, trust SJT and note over- or under-confidence in the report.", "note": "Option order is shuffled; scores are hidden from the student.", "item_count": 72}}
{"id": "M6-TEAM-0001", "module": 6, "sub": "TEAM", "type": "sjt", "grade": "both", "stem": "In a group project one member does no work and the deadline is in three days. You...", "options": [{"k": "A", "text": "Complain to the teacher without talking to them", "score": 1}, {"k": "B", "text": "Talk to them privately, ask what is blocking them and offer a specific task", "score": 3}, {"k": "C", "text": "Do their share yourself without saying anything", "score": 2}, {"k": "D", "text": "Reduce your own effort too", "score": 0}], "key": {"apply": "score of chosen option, 0 to 3"}}
{"id": "M6-TEAM-0002", "module": 6, "sub": "TEAM", "type": "sjt", "grade": "both", "stem": "Two teammates disagree strongly about how to do the project. You...", "options": [{"k": "A", "text": "Suggest listing pros and cons of both and testing a small part of each", "score": 3}, {"k": "B", "text": "Let them fight it out", "score": 1}, {"k": "C", "text": "Quit the group", "score": 0}, {"k": "D", "text": "Support the louder friend to end the argument", "score": 2}], "key": {"apply": "score of chosen option, 0 to 3"}}
{"id": "M6-TEAM-0003", "module": 6, "sub": "TEAM", "type": "sjt", "grade": "both", "stem": "Your idea is not chosen by the group. You...", "options": [{"k": "A", "text": "Keep arguing at every meeting", "score": 0}, {"k": "B", "text": "Accept it, ask how to improve the chosen plan and help", "score": 3}, {"k": "C", "text": "Agree but stay silent", "score": 2}, {"k": "D", "text": "Sulk and do the minimum", "score": 1}], "key": {"apply": "score of chosen option, 0 to 3"}}
{"id": "M6-TEAM-0004", "module": 6, "sub": "TEAM", "type": "sjt", "grade": "both", "stem": "Your team wins a prize and the teacher praises only you. You...", "options": [{"k": "A", "text": "Take all the credit", "score": 0}, {"k": "B", "text": "Thank the teacher and name your teammates' contributions", "score": 3}, {"k": "C", "text": "Say nothing and feel awkward", "score": 1}, {"k": "D", "text": "Accept the praise quietly", "score": 2}], "key": {"apply": "score of chosen option, 0 to 3"}}
{"id": "M6-TEAM-0005", "module": 6, "sub": "TEAM", "type": "sjt", "grade": "both", "stem": "A new student joins your team and does not know anyone. You...", "options": [{"k": "A", "text": "Say hello and carry on", "score": 2}, {"k": "B", "text": "Wait for them to approach you", "score": 1}, {"k": "C", "text": "Introduce yourself, explain the plan and give them a small task", "score": 3}, {"k": "D", "text": "Ignore them until they prove useful", "score": 0}], "key": {"apply": "score of chosen option, 0 to 3"}}
{"id": "M6-TEAM-0006", "module": 6, "sub": "TEAM", "type": "sjt", "grade": "both", "stem": "Your team is behind schedule and members start blaming each other. You...", "options": [{"k": "A", "text": "Leave the others and finish only your part", "score": 0}, {"k": "B", "text": "Ask the teacher to assign tasks", "score": 2}, {"k": "C", "text": "Pause the blame, list what is pending and split work by strengths", "score": 3}, {"k": "D", "text": "Join in the blaming", "score": 1}], "key": {"apply": "score of chosen option, 0 to 3"}}
{"id": "M6-STRESS-0007", "module": 6, "sub": "STRESS", "type": "sjt", "grade": "both", "stem": "The night before a major exam you realise you have not covered one important chapter. You...", "options": [{"k": "A", "text": "Study all night without a break", "score": 2}, {"k": "B", "text": "Panic and message friends for help", "score": 1}, {"k": "C", "text": "Give up on the exam", "score": 0}, {"k": "D", "text": "Make a quick plan: key topics first, short breaks, and still sleep", "score": 3}], "key": {"apply": "score of chosen option, 0 to 3"}}
{"id": "M6-STRESS-0008", "module": 6, "sub": "STRESS", "type": "sjt", "grade": "both", "stem": "You get much lower marks than expected. You...", "options": [{"k": "A", "text": "Blame the question paper", "score": 1}, {"k": "B", "text": "Check your mistakes, make an improvement plan and talk to the teacher", "score": 3}, {"k": "C", "text": "Feel low for a few days and then recover", "score": 2}, {"k": "D", "text": "Decide you are bad at the subject", "score": 0}], "key": {"apply": "score of chosen option, 0 to 3"}}
{"id": "M6-STRESS-0009", "module": 6, "sub": "STRESS", "type": "sjt", "grade": "both", "stem": "You must speak on stage in five minutes and your heart is racing. You...", "options": [{"k": "A", "text": "Rush and read as fast as possible", "score": 0}, {"k": "B", "text": "Tell yourself it will soon be over", "score": 2}, {"k": "C", "text": "Look for an excuse to skip", "score": 1}, {"k": "D", "text": "Breathe slowly, recall your first line and focus on your message", "score": 3}], "key": {"apply": "score of chosen option, 0 to 3"}}
{"id": "M6-STRESS-0010", "module": 6, "sub": "STRESS", "type": "sjt", "grade": "both", "stem": "Project, test and event are all due in the same week. You...", "options": [{"k": "A", "text": "Do the easiest first", "score": 2}, {"k": "B", "text": "Do whatever you feel like", "score": 1}, {"k": "C", "text": "List everything, prioritise by deadline and weight, ask for help if needed", "score": 3}, {"k": "D", "text": "Ignore it until pressure builds", "score": 0}], "key": {"apply": "score of chosen option, 0 to 3"}}
{"id": "M6-STRESS-0011", "module": 6, "sub": "STRESS", "type": "sjt", "grade": "both", "stem": "A friend says something hurtful just before your exam. You...", "options": [{"k": "A", "text": "Try to ignore it but keep thinking about it", "score": 2}, {"k": "B", "text": "Argue immediately", "score": 1}, {"k": "C", "text": "Skip exam preparation that day", "score": 0}, {"k": "D", "text": "Note it, decide to talk later and focus on the exam", "score": 3}], "key": {"apply": "score of chosen option, 0 to 3"}}
{"id": "M6-STRESS-0012", "module": 6, "sub": "STRESS", "type": "sjt", "grade": "both", "stem": "You lose a competition you prepared for months. You...", "options": [{"k": "A", "text": "Tell everyone it was unfair", "score": 1}, {"k": "B", "text": "Swear never to compete again", "score": 0}, {"k": "C", "text": "Let yourself feel disappointed, review what happened and set the next goal", "score": 3}, {"k": "D", "text": "Take a long break from it", "score": 2}], "key": {"apply": "score of chosen option, 0 to 3"}}
{"id": "M6-LEAD-0013", "module": 6, "sub": "LEAD", "type": "sjt", "grade": "both", "stem": "Your class club has no leader and activities are stuck. You...", "options": [{"k": "A", "text": "Suggest someone else should lead", "score": 2}, {"k": "B", "text": "Leave the club", "score": 0}, {"k": "C", "text": "Call a meeting, propose roles and offer to coordinate", "score": 3}, {"k": "D", "text": "Wait for the teacher to act", "score": 1}], "key": {"apply": "score of chosen option, 0 to 3"}}
{"id": "M6-LEAD-0014", "module": 6, "sub": "LEAD", "type": "sjt", "grade": "both", "stem": "As team captain, a teammate regularly arrives late. You...", "options": [{"k": "A", "text": "Ignore it", "score": 1}, {"k": "B", "text": "Speak privately, understand the reason and agree on expectations", "score": 3}, {"k": "C", "text": "Replace them without talking", "score": 0}, {"k": "D", "text": "Warn them in front of everyone", "score": 2}], "key": {"apply": "score of chosen option, 0 to 3"}}
{"id": "M6-LEAD-0015", "module": 6, "sub": "LEAD", "type": "sjt", "grade": "both", "stem": "Your team must decide quickly but opinions are split. You...", "options": [{"k": "A", "text": "Decide alone without listening", "score": 0}, {"k": "B", "text": "Hear the key points, decide with a clear reason and explain it", "score": 3}, {"k": "C", "text": "Take a vote without any discussion", "score": 2}, {"k": "D", "text": "Delay until everyone agrees", "score": 1}], "key": {"apply": "score of chosen option, 0 to 3"}}
{"id": "M6-LEAD-0016", "module": 6, "sub": "LEAD", "type": "sjt", "grade": "both", "stem": "A plan you led has failed. You...", "options": [{"k": "A", "text": "Explain what went wrong with help from others", "score": 2}, {"k": "B", "text": "Blame a teammate", "score": 0}, {"k": "C", "text": "Blame circumstances", "score": 1}, {"k": "D", "text": "Own the mistake, share lessons and propose a fix", "score": 3}], "key": {"apply": "score of chosen option, 0 to 3"}}
{"id": "M6-LEAD-0017", "module": 6, "sub": "LEAD", "type": "sjt", "grade": "both", "stem": "A junior member is shy but talented. You...", "options": [{"k": "A", "text": "Leave them alone", "score": 1}, {"k": "B", "text": "Praise them in public", "score": 2}, {"k": "C", "text": "Give them a role that uses their strength and encourage them", "score": 3}, {"k": "D", "text": "Always pick more confident members", "score": 0}], "key": {"apply": "score of chosen option, 0 to 3"}}
{"id": "M6-LEAD-0018", "module": 6, "sub": "LEAD", "type": "sjt", "grade": "both", "stem": "Your team has little time and many ideas. You...", "options": [{"k": "A", "text": "Try all the ideas", "score": 2}, {"k": "B", "text": "Choose your own idea", "score": 1}, {"k": "C", "text": "Set the goal, pick the two best ideas using criteria and assign tasks", "score": 3}, {"k": "D", "text": "Do nothing until the last day", "score": 0}], "key": {"apply": "score of chosen option, 0 to 3"}}
{"id": "M6-COMM-0019", "module": 6, "sub": "COMM", "type": "sjt", "grade": "both", "stem": "You disagree with how a teacher marked your answer. You...", "options": [{"k": "A", "text": "Ask a friend to complain for you", "score": 2}, {"k": "B", "text": "Complain loudly in class", "score": 1}, {"k": "C", "text": "Say nothing but stay resentful", "score": 0}, {"k": "D", "text": "Politely ask for a meeting and show your reasoning", "score": 3}], "key": {"apply": "score of chosen option, 0 to 3"}}
{"id": "M6-COMM-0020", "module": 6, "sub": "COMM", "type": "sjt", "grade": "both", "stem": "A friend is confused by a hard concept. You...", "options": [{"k": "A", "text": "Use a simple example and ask them to explain it back", "score": 3}, {"k": "B", "text": "Repeat the textbook lines", "score": 2}, {"k": "C", "text": "Tell them to read it again", "score": 1}, {"k": "D", "text": "Say it is easy and move on", "score": 0}], "key": {"apply": "score of chosen option, 0 to 3"}}
{"id": "M6-COMM-0021", "module": 6, "sub": "COMM", "type": "sjt", "grade": "both", "stem": "You must ask a stranger for help in a new city. You...", "options": [{"k": "A", "text": "Ask clearly and politely, then say thanks", "score": 3}, {"k": "B", "text": "Ask in a hurry", "score": 2}, {"k": "C", "text": "Try only using your phone", "score": 1}, {"k": "D", "text": "Avoid asking", "score": 0}], "key": {"apply": "score of chosen option, 0 to 3"}}
{"id": "M6-COMM-0022", "module": 6, "sub": "COMM", "type": "sjt", "grade": "both", "stem": "A message in the class group chat is misunderstood and people get angry. You...", "options": [{"k": "A", "text": "Leave it as it is", "score": 1}, {"k": "B", "text": "Delete the message", "score": 2}, {"k": "C", "text": "Reply angrily", "score": 0}, {"k": "D", "text": "Clarify calmly and apologise if it was unclear", "score": 3}], "key": {"apply": "score of chosen option, 0 to 3"}}
{"id": "M6-COMM-0023", "module": 6, "sub": "COMM", "type": "sjt", "grade": "both", "stem": "You need to tell a friend their work has mistakes. You...", "options": [{"k": "A", "text": "Hint indirectly", "score": 2}, {"k": "B", "text": "Say nothing", "score": 0}, {"k": "C", "text": "Point out specific issues kindly and offer to help", "score": 3}, {"k": "D", "text": "Tell other people", "score": 1}], "key": {"apply": "score of chosen option, 0 to 3"}}
{"id": "M6-COMM-0024", "module": 6, "sub": "COMM", "type": "sjt", "grade": "both", "stem": "You get two minutes to present an idea to the principal. You...", "options": [{"k": "A", "text": "Prepare slides but read them out", "score": 2}, {"k": "B", "text": "Say you are not ready", "score": 0}, {"k": "C", "text": "Try to share every detail", "score": 1}, {"k": "D", "text": "State the problem, the solution and the benefit clearly", "score": 3}], "key": {"apply": "score of chosen option, 0 to 3"}}
{"id": "M6-EMPATHY-0025", "module": 6, "sub": "EMPATHY", "type": "sjt", "grade": "both", "stem": "A classmate is sitting alone and looks upset. You...", "options": [{"k": "A", "text": "Ask a friend to check on them", "score": 2}, {"k": "B", "text": "Laugh at them", "score": 0}, {"k": "C", "text": "Notice but do nothing", "score": 1}, {"k": "D", "text": "Sit nearby and gently ask if they want to talk", "score": 3}], "key": {"apply": "score of chosen option, 0 to 3"}}
{"id": "M6-EMPATHY-0026", "module": 6, "sub": "EMPATHY", "type": "sjt", "grade": "both", "stem": "A friend is selected for something you also wanted. You...", "options": [{"k": "A", "text": "Congratulate but then avoid them", "score": 2}, {"k": "B", "text": "Congratulate them sincerely and deal with your disappointment privately", "score": 3}, {"k": "C", "text": "Stay silent", "score": 1}, {"k": "D", "text": "Say they were just lucky", "score": 0}], "key": {"apply": "score of chosen option, 0 to 3"}}
{"id": "M6-EMPATHY-0027", "module": 6, "sub": "EMPATHY", "type": "sjt", "grade": "both", "stem": "Your younger sibling is scared of the dark. You...", "options": [{"k": "A", "text": "Say it is silly but stay with them", "score": 2}, {"k": "B", "text": "Listen, reassure them and offer a small light", "score": 3}, {"k": "C", "text": "Tell them to be brave", "score": 1}, {"k": "D", "text": "Tease them", "score": 0}], "key": {"apply": "score of chosen option, 0 to 3"}}
{"id": "M6-EMPATHY-0028", "module": 6, "sub": "EMPATHY", "type": "sjt", "grade": "both", "stem": "A classmate is being teased. You...", "options": [{"k": "A", "text": "Watch silently", "score": 1}, {"k": "B", "text": "Join in", "score": 0}, {"k": "C", "text": "Calmly speak up or support them afterwards and report it if needed", "score": 3}, {"k": "D", "text": "Support them privately later", "score": 2}], "key": {"apply": "score of chosen option, 0 to 3"}}
{"id": "M6-EMPATHY-0029", "module": 6, "sub": "EMPATHY", "type": "sjt", "grade": "both", "stem": "A friend shares a personal problem and asks you to keep it secret. You...", "options": [{"k": "A", "text": "Listen, keep the confidence and encourage help if it is serious", "score": 3}, {"k": "B", "text": "Listen and give advice", "score": 2}, {"k": "C", "text": "Post about it online", "score": 0}, {"k": "D", "text": "Tell one other friend", "score": 1}], "key": {"apply": "score of chosen option, 0 to 3"}}
{"id": "M6-EMPATHY-0030", "module": 6, "sub": "EMPATHY", "type": "sjt", "grade": "both", "stem": "An elderly neighbour finds it hard to use a phone app. You...", "options": [{"k": "A", "text": "Tell them to ask someone else", "score": 1}, {"k": "B", "text": "Patiently show them step by step", "score": 3}, {"k": "C", "text": "Do it for them quickly", "score": 2}, {"k": "D", "text": "Make fun of it", "score": 0}], "key": {"apply": "score of chosen option, 0 to 3"}}
{"id": "M6-SELFCONTROL-0031", "module": 6, "sub": "SELFCONTROL", "type": "sjt", "grade": "both", "stem": "Your phone buzzes during a study session. You...", "options": [{"k": "A", "text": "Check it quickly", "score": 2}, {"k": "B", "text": "Keep it away and check it at the break", "score": 3}, {"k": "C", "text": "Spend the hour on the phone", "score": 0}, {"k": "D", "text": "Scroll for a while", "score": 1}], "key": {"apply": "score of chosen option, 0 to 3"}}
{"id": "M6-SELFCONTROL-0032", "module": 6, "sub": "SELFCONTROL", "type": "sjt", "grade": "both", "stem": "Someone insults you in public. You...", "options": [{"k": "A", "text": "Stay calm, reply briefly or walk away and talk later", "score": 3}, {"k": "B", "text": "Insult them back", "score": 1}, {"k": "C", "text": "Get into a fight", "score": 0}, {"k": "D", "text": "Ignore it but feel angry", "score": 2}], "key": {"apply": "score of chosen option, 0 to 3"}}
{"id": "M6-SELFCONTROL-0033", "module": 6, "sub": "SELFCONTROL", "type": "sjt", "grade": "both", "stem": "You decided to finish homework before gaming but friends invite you to play. You...", "options": [{"k": "A", "text": "Finish first and join later", "score": 3}, {"k": "B", "text": "Join for thirty minutes", "score": 2}, {"k": "C", "text": "Skip the homework", "score": 0}, {"k": "D", "text": "Join and rush the homework", "score": 1}], "key": {"apply": "score of chosen option, 0 to 3"}}
{"id": "M6-SELFCONTROL-0034", "module": 6, "sub": "SELFCONTROL", "type": "sjt", "grade": "both", "stem": "You are offered a shortcut to cheat in a test. You...", "options": [{"k": "A", "text": "Accept", "score": 0}, {"k": "B", "text": "Refuse, because you want your own result", "score": 3}, {"k": "C", "text": "Hesitate and then refuse", "score": 2}, {"k": "D", "text": "Consider it", "score": 1}], "key": {"apply": "score of chosen option, 0 to 3"}}
{"id": "M6-SELFCONTROL-0035", "module": 6, "sub": "SELFCONTROL", "type": "sjt", "grade": "both", "stem": "You receive an unexpected gift of ₹5,000. You...", "options": [{"k": "A", "text": "Lend it to anyone who asks", "score": 0}, {"k": "B", "text": "Save most of it and spend a small part", "score": 3}, {"k": "C", "text": "Spend it on impulse", "score": 1}, {"k": "D", "text": "Spend half", "score": 2}], "key": {"apply": "score of chosen option, 0 to 3"}}
{"id": "M6-SELFCONTROL-0036", "module": 6, "sub": "SELFCONTROL", "type": "sjt", "grade": "both", "stem": "A coach criticises your performance harshly in front of others. You...", "options": [{"k": "A", "text": "Walk out", "score": 0}, {"k": "B", "text": "Argue back", "score": 1}, {"k": "C", "text": "Listen, learn and ask for tips later", "score": 3}, {"k": "D", "text": "Accept it but feel hurt", "score": 2}], "key": {"apply": "score of chosen option, 0 to 3"}}
{"id": "M6-TEAM-0037", "module": 6, "sub": "TEAM", "type": "likert5", "grade": "both", "stem": "I enjoy helping my team succeed even when I get less credit.", "scale": "AGREE5", "key": {"scale": "TEAM", "reverse": false}}
{"id": "M6-TEAM-0038", "module": 6, "sub": "TEAM", "type": "likert5", "grade": "both", "stem": "I listen to other opinions before deciding.", "scale": "AGREE5", "key": {"scale": "TEAM", "reverse": false}}
{"id": "M6-TEAM-0039", "module": 6, "sub": "TEAM", "type": "likert5", "grade": "both", "stem": "I share work fairly in a group.", "scale": "AGREE5", "key": {"scale": "TEAM", "reverse": false}}
{"id": "M6-TEAM-0040", "module": 6, "sub": "TEAM", "type": "likert5", "grade": "both", "stem": "I prefer to do everything myself because others slow me down.", "scale": "AGREE5", "key": {"scale": "TEAM", "reverse": true}}
{"id": "M6-TEAM-0041", "module": 6, "sub": "TEAM", "type": "likert5", "grade": "both", "stem": "I get annoyed when teammates disagree with me.", "scale": "AGREE5", "key": {"scale": "TEAM", "reverse": true}}
{"id": "M6-TEAM-0042", "module": 6, "sub": "TEAM", "type": "likert5", "grade": "both", "stem": "I avoid group tasks if I can.", "scale": "AGREE5", "key": {"scale": "TEAM", "reverse": true}}
{"id": "M6-STRESS-0043", "module": 6, "sub": "STRESS", "type": "likert5", "grade": "both", "stem": "I stay calm under pressure.", "scale": "AGREE5", "key": {"scale": "STRESS", "reverse": false}}
{"id": "M6-STRESS-0044", "module": 6, "sub": "STRESS", "type": "likert5", "grade": "both", "stem": "I know how to calm myself when I am nervous.", "scale": "AGREE5", "key": {"scale": "STRESS", "reverse": false}}
{"id": "M6-STRESS-0045", "module": 6, "sub": "STRESS", "type": "likert5", "grade": "both", "stem": "I can focus on a task even when I am worried.", "scale": "AGREE5", "key": {"scale": "STRESS", "reverse": false}}
{"id": "M6-STRESS-0046", "module": 6, "sub": "STRESS", "type": "likert5", "grade": "both", "stem": "I panic when I have too much to do.", "scale": "AGREE5", "key": {"scale": "STRESS", "reverse": true}}
{"id": "M6-STRESS-0047", "module": 6, "sub": "STRESS", "type": "likert5", "grade": "both", "stem": "A small failure can ruin my whole day.", "scale": "AGREE5", "key": {"scale": "STRESS", "reverse": true}}
{"id": "M6-STRESS-0048", "module": 6, "sub": "STRESS", "type": "likert5", "grade": "both", "stem": "I lose focus when I am nervous.", "scale": "AGREE5", "key": {"scale": "STRESS", "reverse": true}}
{"id": "M6-LEAD-0049", "module": 6, "sub": "LEAD", "type": "likert5", "grade": "both", "stem": "Others often ask me for direction.", "scale": "AGREE5", "key": {"scale": "LEAD", "reverse": false}}
{"id": "M6-LEAD-0050", "module": 6, "sub": "LEAD", "type": "likert5", "grade": "both", "stem": "I take responsibility for group results.", "scale": "AGREE5", "key": {"scale": "LEAD", "reverse": false}}
{"id": "M6-LEAD-0051", "module": 6, "sub": "LEAD", "type": "likert5", "grade": "both", "stem": "I can motivate others to keep trying.", "scale": "AGREE5", "key": {"scale": "LEAD", "reverse": false}}
{"id": "M6-LEAD-0052", "module": 6, "sub": "LEAD", "type": "likert5", "grade": "both", "stem": "I avoid taking charge.", "scale": "AGREE5", "key": {"scale": "LEAD", "reverse": true}}
{"id": "M6-LEAD-0053", "module": 6, "sub": "LEAD", "type": "likert5", "grade": "both", "stem": "I wait for others to decide.", "scale": "AGREE5", "key": {"scale": "LEAD", "reverse": true}}
{"id": "M6-LEAD-0054", "module": 6, "sub": "LEAD", "type": "likert5", "grade": "both", "stem": "I dislike being responsible for others' work.", "scale": "AGREE5", "key": {"scale": "LEAD", "reverse": true}}
{"id": "M6-COMM-0055", "module": 6, "sub": "COMM", "type": "likert5", "grade": "both", "stem": "I can explain my ideas clearly.", "scale": "AGREE5", "key": {"scale": "COMM", "reverse": false}}
{"id": "M6-COMM-0056", "module": 6, "sub": "COMM", "type": "likert5", "grade": "both", "stem": "I listen carefully without interrupting.", "scale": "AGREE5", "key": {"scale": "COMM", "reverse": false}}
{"id": "M6-COMM-0057", "module": 6, "sub": "COMM", "type": "likert5", "grade": "both", "stem": "I speak politely even when I disagree.", "scale": "AGREE5", "key": {"scale": "COMM", "reverse": false}}
{"id": "M6-COMM-0058", "module": 6, "sub": "COMM", "type": "likert5", "grade": "both", "stem": "I find it hard to put my ideas into words.", "scale": "AGREE5", "key": {"scale": "COMM", "reverse": true}}
{"id": "M6-COMM-0059", "module": 6, "sub": "COMM", "type": "likert5", "grade": "both", "stem": "I avoid speaking up in class.", "scale": "AGREE5", "key": {"scale": "COMM", "reverse": true}}
{"id": "M6-COMM-0060", "module": 6, "sub": "COMM", "type": "likert5", "grade": "both", "stem": "People often misunderstand me.", "scale": "AGREE5", "key": {"scale": "COMM", "reverse": true}}
{"id": "M6-EMPATHY-0061", "module": 6, "sub": "EMPATHY", "type": "likert5", "grade": "both", "stem": "I notice quickly when someone is sad.", "scale": "AGREE5", "key": {"scale": "EMPATHY", "reverse": false}}
