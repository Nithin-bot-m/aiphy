{
  "name": "psychometric-ai-web",
  "version": "2.0.0",
  "private": true,
  "description": "Grade 10 educational stream & career guidance platform — Next.js 16 frontend + Express psychometric core",
  "scripts": {
    "dev": "node scripts/dev-all.js",
    "dev:fe": "next dev -p 3000",
    "dev:be": "npm --prefix psychometric-ai run dev",
    "build": "next build && node scripts/copy-standalone.js",
    "start": "node .next/standalone/server.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "npm --prefix psychometric-ai test",
    "test:unit": "npm --prefix psychometric-ai run test:unit",
    "test:integration": "npm --prefix psychometric-ai run test:integration",
    "test:security": "npm --prefix psychometric-ai run test:security",
    "db:migrate": "node psychometric-ai/backend/src/migrations/migrate.js",
    "db:seed": "node psychometric-ai/backend/seeds/runSeed.js",
    "deploy:cf": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "preview:cf": "opennextjs-cloudflare build && opennextjs-cloudflare preview"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "next": "^16.4.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.17",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.13.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.1.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "^3.114.0"
  }
}
